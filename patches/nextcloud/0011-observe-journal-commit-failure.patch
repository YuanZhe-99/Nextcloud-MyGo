+        rejectCommit = false;
+        QVERIFY(journal.hasCommitError());
+        journal.close();
+        QVERIFY(journal.hasCommitError());
+        QVERIFY(journal.open());
+        QVERIFY(journal.hasCommitError());
+        journal.close();
+        SyncJournalDb recovered(path);
