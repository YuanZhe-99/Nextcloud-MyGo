 using namespace OCC;
 using namespace Qt::StringLiterals;
 
+namespace
+{
+// Only the isolated commit regression enables this hook, after schema creation.
+bool rejectCommit = false;
+
+/// rejectTestCommit makes SQLite roll back a real commit without altering production code.
+int rejectTestCommit(void *)
+{
+    return rejectCommit ? 1 : 0;
+}
+
+/// installCommitHook instruments connections opened during the isolated regression.
+int installCommitHook(sqlite3 *db, char **, const sqlite3_api_routines *)
+{
+    sqlite3_commit_hook(db, rejectTestCommit, nullptr);
+    return SQLITE_OK;
+}
+}
