+        SyncJournalFileRecord record;
+        record._path = "uncommitted";
+        record._type = ItemTypeFile;
+        record._etag = "owned";
+        record._fileId = "owned";
+        record._modtime = 1;
+        QVERIFY(journal.setFileRecord(record));
+        rejectCommit = true;
