diff --git a/test/testsyncengine.cpp b/test/testsyncengine.cpp
--- a/test/testsyncengine.cpp
+++ b/test/testsyncengine.cpp
@@ -102,6 +102,30 @@
     Q_OBJECT
 
 private Q_SLOTS:
+    // A pre-propagation policy veto must leave both sides unchanged and permit a later cycle.
+    void testAbortBeforePropagation()
+    {
+        FakeFolder fakeFolder{FileInfo::A12_B12_C12_S12()};
+        fakeFolder.localModifier().insert("local-policy-fixture");
+        fakeFolder.remoteModifier().insert("remote-policy-fixture");
+        const auto local = fakeFolder.currentLocalState();
+        const auto remote = fakeFolder.currentRemoteState();
+        auto observed = false;
+        const auto connection = connect(&fakeFolder.syncEngine(), &SyncEngine::aboutToPropagate,
+            &fakeFolder.syncEngine(), [&](SyncFileItemVector &) {
+                observed = true;
+                fakeFolder.syncEngine().abort();
+            }, Qt::DirectConnection);
+        QVERIFY(!fakeFolder.syncOnce());
+        QVERIFY(observed);
+        QCoreApplication::sendPostedEvents(nullptr, QEvent::DeferredDelete);
+        QCOMPARE(fakeFolder.currentLocalState(), local);
+        QCOMPARE(fakeFolder.currentRemoteState(), remote);
+        disconnect(connection);
+        QVERIFY(fakeFolder.syncOnce());
+        QCOMPARE(fakeFolder.currentLocalState(), fakeFolder.currentRemoteState());
+    }
+
     void initTestCase()
     {
         Logger::instance()->setLogFlush(true);
