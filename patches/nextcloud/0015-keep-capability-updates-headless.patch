+    /// Verifies that installing sync capabilities cannot re-enable interactive services on a headless account.
+    void testHeadlessCapabilitiesKeepServicesDisabled()
+    {
+        auto account = Account::create(false);
+        account->setCapabilities({{u"dav"_s, QVariantMap{{u"chunking"_s, u"1.0"_s}}}});
+        const auto hasUserStatus = bool(account->userStatusConnector());
+        const auto hasPush = account->pushNotifications() != nullptr;
+        const auto hasChunking = account->capabilities().chunkingNg();
+        account->e2e()->setAccount({});
+        QVERIFY(hasChunking);
+        QVERIFY(!hasUserStatus);
+        QVERIFY(!hasPush);
+    }
