+    // An owner that creates a new engine for every sync carries the restart flag into the next one.
+    void testRestartAfterLocalRemovalCarriesToTheNextEngine()
+    {
+        FakeFolder fakeFolder{FileInfo{}};
+        setupVfs(fakeFolder);
+        fakeFolder.remoteModifier().insert("a", 64);
+        QVERIFY(fakeFolder.syncOnce());
+        QVERIFY(!fakeFolder.syncEngine().restartedSyncAfterDiscovery());
+
+        // A local removal fails the sync once, asking for a delayed follow-up.
+        fakeFolder.localModifier().remove("a");
+        QVERIFY(!fakeFolder.syncOnce());
+        QVERIFY(fakeFolder.syncEngine().restartedSyncAfterDiscovery());
+        QCOMPARE(fakeFolder.syncEngine().isAnotherSyncNeeded(), DelayedFollowUp);
+        QVERIFY(fakeFolder.currentRemoteState().find("a"));
+
+        // A new engine that starts without the flag restarts again, every time.
+        fakeFolder.syncEngine().setRestartedSyncAfterDiscovery(false);
+        QVERIFY(!fakeFolder.syncOnce());
+        QVERIFY(fakeFolder.currentRemoteState().find("a"));
+
+        // Carried over, the next sync trusts its discovery, removes the file and clears the flag.
+        const auto restarted = fakeFolder.syncEngine().restartedSyncAfterDiscovery();
+        QVERIFY(restarted);
+        fakeFolder.syncEngine().setRestartedSyncAfterDiscovery(restarted);
+        QVERIFY(fakeFolder.syncOnce());
+        QVERIFY(!fakeFolder.currentRemoteState().find("a"));
+        QVERIFY(!fakeFolder.syncEngine().restartedSyncAfterDiscovery());
+    }
+
     void testServer_caseClash_createConflict()
