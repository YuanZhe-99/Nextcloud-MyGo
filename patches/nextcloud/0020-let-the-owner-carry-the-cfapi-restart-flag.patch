diff --git a/src/libsync/syncengine.h b/src/libsync/syncengine.h
--- a/src/libsync/syncengine.h
+++ b/src/libsync/syncengine.h
@@ -80,6 +80,16 @@ public:
     /* Returns whether another sync is needed to complete the sync */
     [[nodiscard]] AnotherSyncNeeded isAnotherSyncNeeded() const { return _anotherSyncNeeded; }
 
+    /** Whether the last sync that reached reconcile was failed once to be restarted
+     *
+     * With Windows CfApi, a sync whose discovery found a local removal is failed once and
+     * the next one trusts its discovery (see shouldRestartSync()). The flag lives in the
+     * engine: an owner that creates a new engine for every sync carries it into the next
+     * engine, or every such sync is restarted again and the removal never propagates.
+     */
+    [[nodiscard]] bool restartedSyncAfterDiscovery() const { return _restartedSyncAfterDiscovery; }
+    void setRestartedSyncAfterDiscovery(bool restarted) { _restartedSyncAfterDiscovery = restarted; }
+
     [[nodiscard]] bool wasFileTouched(const QString &fn) const;
 
     [[nodiscard]] AccountPtr account() const { return _account; };
