+    /// Preserves a corrupt journal across repeated failed opens instead of silently recreating it.
+    void testCorruptJournalIsPreserved()
+    {
+        QTemporaryDir directory;
+        QVERIFY(directory.isValid());
+        const auto path = directory.filePath("corrupt.db");
+        const QByteArray original("owned-corrupt-journal-do-not-rebuild");
+        QFile file(path);
+        QVERIFY(file.open(QIODevice::WriteOnly));
+        QCOMPARE(file.write(original), original.size());
+        file.close();
+        SyncJournalDb journal(path);
+        for (auto attempt = 0; attempt < 2; ++attempt) {
+            QVERIFY(!journal.open());
+            journal.close();
+            QVERIFY(file.open(QIODevice::ReadOnly));
+            QCOMPARE(file.readAll(), original);
+            file.close();
+        }
+    }
