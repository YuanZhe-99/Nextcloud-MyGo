+    // A placeholder created by listing a folder on demand stores the file ID as sync-created placeholders do.
+    void testOnDemandListingStoresTheFileIdentity()
+    {
+        FakeFolder fakeFolder{FileInfo{}};
+        setupVfs(fakeFolder);
+        fakeFolder.remoteModifier().mkdir("A");
+        QVERIFY(fakeFolder.syncOnce());
+        QCOMPARE(dbRecord(fakeFolder, "A")._type, ItemTypeVirtualDirectory);
+
+        // Added after the sync, so only the listing creates its placeholder.
+        fakeFolder.remoteModifier().insert("A/a1", 64);
+        const auto fileId = fakeFolder.remoteModifier().find("A/a1")->fileId;
+
+        // The provider refuses listings by its own process, so another process lists the folder.
+        QProcess dir;
+        dir.setProgram(QStringLiteral("cmd.exe"));
+        dir.setArguments({QStringLiteral("/c"), QStringLiteral("dir"), QStringLiteral("/b"), QDir::toNativeSeparators(fakeFolder.localPath() + "A")});
+        dir.start();
+        QVERIFY(QTest::qWaitFor([&dir] { return dir.state() == QProcess::NotRunning; }, 30000));
+        QVERIFY(dir.readAllStandardOutput().contains("a1"));
+
+        const auto info = cfapi::findPlaceholderInfo(fakeFolder.localPath() + "A/a1");
+        QVERIFY(info);
+        const auto identity = QByteArray(reinterpret_cast<const char *>(info->FileIdentity), static_cast<int>(info->FileIdentityLength));
+        QCOMPARE(identity, fileId);
+    }
+
