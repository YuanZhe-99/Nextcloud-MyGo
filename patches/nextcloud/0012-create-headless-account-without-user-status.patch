+    /// Verifies that a headless account can be released after its unused E2EE back-reference is cleared.
+    void testHeadlessAccountRelease()
+    {
+        auto account = Account::create(false);
+        QPointer<Account> witness(account.data());
+        QVERIFY(!account->userStatusConnector());
+        QVERIFY(account->sharedFromThis() == account);
+        account->e2e()->setAccount({});
+        account.reset();
+        QVERIFY(witness.isNull());
+    }
