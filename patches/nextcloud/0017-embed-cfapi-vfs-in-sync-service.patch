+
+bool VfsCfApi::beginRequest()
+{
+    // Count before reading the refusal, so an owner that refuses and then sees no request in flight cannot miss one.
+    ++d->requestsInFlight;
+    return !d->refusingRequests;
+}
+
+void VfsCfApi::endRequest()
+{
+    --d->requestsInFlight;
