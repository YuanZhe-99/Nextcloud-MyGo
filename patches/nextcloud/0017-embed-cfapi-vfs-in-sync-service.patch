+    // A caller-supplied account identity names the sync root; without the shell extension no handler class is registered for it.
+    void testSyncRootAccountIdWithoutShellExtension()
+    {
+        FakeFolder fakeFolder{FileInfo{}};
+        const auto syncRoots = u"HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\SyncRootManager"_s;
+        const auto findSyncRoot = [&] {
+            const auto groups = QSettings(syncRoots, QSettings::NativeFormat).childGroups();
+            const auto found = std::find_if(groups.cbegin(), groups.cend(), [](const QString &name) {
+                return name.startsWith(u"OC-TEST!"_s) && name.endsWith(u"!stable-account!stable-alias"_s);
+            });
+            return found == groups.cend() ? QString{} : *found;
+        };
+        QVERIFY(findSyncRoot().isEmpty());
+
+        auto vfs = QSharedPointer<Vfs>(createVfsFromPlugin(Vfs::WindowsCfApi).release());
+        VfsSetupParams params;
+        params.filesystemPath = fakeFolder.localPath();
+        params.rootPath = FileSystem::Path{fakeFolder.localPath()};
+        params.remotePath = u"/"_s;
+        params.account = fakeFolder.account();
+        params.journal = &fakeFolder.syncJournal();
+        params.providerName = u"OC-TEST"_s;
+        params.providerVersion = u"0.1"_s;
+        params.alias = u"stable-alias"_s;
+        params.syncRootAccountId = u"stable-account"_s;
+        vfs->start(params);
+
+        const auto syncRoot = findSyncRoot();
+        QVERIFY(!syncRoot.isEmpty());
+        QSettings key(syncRoots + u"\\"_s + syncRoot, QSettings::NativeFormat);
+        QVERIFY(!key.contains(u"CustomStateHandler"_s));
+        QVERIFY(!key.contains(u"ThumbnailProvider"_s));
+        QVERIFY(!key.contains(u"NamespaceCLSID"_s));
+        QVERIFY(!syncRoot.contains(fakeFolder.account()->displayName()));
+
+        vfs->stop();
+        vfs->unregisterFolder();
+        QVERIFY(findSyncRoot().isEmpty());
+    }
+
+    // After refuseNewRequests() an application opening an online-only file gets an error instead of a download.
+    void testRefusedRequestsFail()
+    {
+        FakeFolder fakeFolder{FileInfo{}};
+        auto vfs = setupVfs(fakeFolder);
+        fakeFolder.remoteModifier().insert("a", 64);
+        fakeFolder.remoteModifier().insert("b", 64);
+        QVERIFY(fakeFolder.syncOnce());
+        CFVERIFY_VIRTUAL(fakeFolder, "a");
+        CFVERIFY_VIRTUAL(fakeFolder, "b");
+
+        // The client itself may not hydrate its own files, so another process reads them;
+        // copy sets an error level when the read fails, unlike type.
+        const auto readInChild = [&](const QString &name) {
+            QProcess reader;
+            reader.setProgram(u"cmd.exe"_s);
+            reader.setNativeArguments(u"/d /c copy /b /y \"%1\" nul > nul"_s.arg(QDir::toNativeSeparators(fakeFolder.localPath() + name)));
+            QSignalSpy finished(&reader, &QProcess::finished);
+            reader.start();
+            if (!finished.wait(30000)) {
+                reader.kill();
+                reader.waitForFinished();
+                return -1;
+            }
+            return reader.exitStatus() == QProcess::NormalExit ? reader.exitCode() : -1;
+        };
+
+        QCOMPARE(readInChild(u"a"_s), 0);
+        QVERIFY(!cfapi::isSparseFile(fakeFolder.localPath() + "a"));
+        QVERIFY(!vfs->hasRequestsInFlight());
+
+        vfs->refuseNewRequests();
+        QVERIFY(readInChild(u"b"_s) != 0);
+        QVERIFY(cfapi::isSparseFile(fakeFolder.localPath() + "b"));
+        QVERIFY(!vfs->hasRequestsInFlight());
+    }
