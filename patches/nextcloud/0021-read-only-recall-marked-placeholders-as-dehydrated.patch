+    // A sparse file with all its content on disk is an ordinary file, also once it is a placeholder:
+    // it is never wiped or read as virtual, its changes upload and remote changes download.
+    void testSparseFileSyncsLikeAnyOtherFile()
+    {
+        FakeFolder fakeFolder{FileInfo{}};
+        auto vfs = setupVfs(fakeFolder);
+        ItemCompletedSpy completeSpy(fakeFolder);
+
+        // A new local sparse file is uploaded and becomes an in-sync placeholder with its content.
+        writeSparseFile(fakeFolder.localPath() + "sparse", 'S');
+        QVERIFY(cfapi::isSparseFile(fakeFolder.localPath() + "sparse"));
+        QVERIFY(!vfs->isDehydratedPlaceholder(fakeFolder.localPath() + "sparse"));
+        QVERIFY(fakeFolder.syncOnce());
+        QVERIFY(itemInstruction(completeSpy, "sparse", CSYNC_INSTRUCTION_NEW));
+        QCOMPARE(completeSpy.findItem("sparse")->_direction, SyncFileItem::Up);
+        QCOMPARE(fakeFolder.currentRemoteState().find("sparse")->size, sparseSize);
+        QCOMPARE(dbRecord(fakeFolder, "sparse")._type, ItemTypeFile);
+        QVERIFY(placeholderState(fakeFolder.localPath() + "sparse") & CF_PLACEHOLDER_STATE_PLACEHOLDER);
+        QVERIFY(cfapi::isSparseFile(fakeFolder.localPath() + "sparse"));
+        QVERIFY(!vfs->isDehydratedPlaceholder(fakeFolder.localPath() + "sparse"));
+        QVERIFY(hasSparseContent(fakeFolder.localPath() + "sparse", 'S'));
+
+        // As after any upload, the next sync only updates metadata; then nothing is left to do.
+        QVERIFY(fakeFolder.syncOnce());
+        completeSpy.clear();
+        QVERIFY(fakeFolder.syncOnce());
+        QVERIFY(completeSpy.isEmpty());
+
+        // A local edit uploads.
+        fakeFolder.localModifier().appendByte("sparse");
+        QVERIFY(fakeFolder.syncOnce());
+        QVERIFY(itemInstruction(completeSpy, "sparse", CSYNC_INSTRUCTION_SYNC));
+        QCOMPARE(completeSpy.findItem("sparse")->_direction, SyncFileItem::Up);
+        QCOMPARE(fakeFolder.currentRemoteState().find("sparse")->size, sparseSize + 1);
+        QCOMPARE(dbRecord(fakeFolder, "sparse")._type, ItemTypeFile);
+
+        // A remote change downloads.
+        completeSpy.clear();
+        fakeFolder.remoteModifier().appendByte("sparse");
+        QVERIFY(fakeFolder.syncOnce());
+        QVERIFY(itemInstruction(completeSpy, "sparse", CSYNC_INSTRUCTION_SYNC));
+        QCOMPARE(completeSpy.findItem("sparse")->_direction, SyncFileItem::Down);
+        QCOMPARE(QFileInfo(fakeFolder.localPath() + "sparse").size(), sparseSize + 2);
+        QCOMPARE(dbRecord(fakeFolder, "sparse")._type, ItemTypeFile);
+
+        // Changed on both sides, it becomes a conflict that keeps the local content.
+        completeSpy.clear();
+        writeSparseFile(fakeFolder.localPath() + "sparse", 'L');
+        fakeFolder.remoteModifier().appendByte("sparse");
+        QVERIFY(fakeFolder.syncOnce());
+        QVERIFY(itemInstruction(completeSpy, "sparse", CSYNC_INSTRUCTION_CONFLICT));
+        const auto conflicts = QDir(fakeFolder.localPath()).entryList({u"sparse (conflicted copy*"_s}, QDir::Files);
+        QCOMPARE(conflicts.size(), 1);
+        QVERIFY(hasSparseContent(fakeFolder.localPath() + conflicts.first(), 'L'));
+        QCOMPARE(QFileInfo(fakeFolder.localPath() + "sparse").size(), sparseSize + 3);
+
+        // Free up space and download again still work for a placeholder that was sparse.
+        writeSparseFile(fakeFolder.localPath() + "freed", 'F');
+        QVERIFY(fakeFolder.syncOnce());
+        ::setPinState(fakeFolder.localPath() + "freed", PinState::OnlineOnly, cfapi::Recurse);
+        QVERIFY(fakeFolder.syncOnce());
+        CFVERIFY_VIRTUAL(fakeFolder, "freed");
+        QVERIFY(vfs->isDehydratedPlaceholder(fakeFolder.localPath() + "freed"));
+        ::setPinState(fakeFolder.localPath() + "freed", PinState::AlwaysLocal, cfapi::Recurse);
+        QVERIFY(fakeFolder.syncOnce());
+        QCOMPARE(dbRecord(fakeFolder, "freed")._type, ItemTypeFile);
+        QVERIFY(!vfs->isDehydratedPlaceholder(fakeFolder.localPath() + "freed"));
+        QCOMPARE(QFileInfo(fakeFolder.localPath() + "freed").size(), sparseSize);
+        QVERIFY(fakeFolder.currentRemoteState().find("freed"));
+    }
