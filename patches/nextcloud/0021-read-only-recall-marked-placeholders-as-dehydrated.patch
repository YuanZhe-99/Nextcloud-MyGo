+// Large enough that zeroing its first half deallocates whole sparse clusters.
+constexpr qint64 sparseSize = 1024 * 1024;
+
+// Writes a sparse file whose first half is a hole and whose second half is contentChar.
+void writeSparseFile(const QString &path, char contentChar)
+{
+    const auto handle = CreateFileW(reinterpret_cast<const wchar_t *>(QDir::toNativeSeparators(path).utf16()), GENERIC_READ | GENERIC_WRITE, 0, nullptr,
+                                    CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    QVERIFY(handle != INVALID_HANDLE_VALUE);
+    DWORD returned = 0;
+    QVERIFY(DeviceIoControl(handle, FSCTL_SET_SPARSE, nullptr, 0, nullptr, 0, &returned, nullptr));
+    const QByteArray content(sparseSize, contentChar);
+    QVERIFY(WriteFile(handle, content.constData(), DWORD(content.size()), &returned, nullptr));
+    FILE_ZERO_DATA_INFORMATION hole = {};
+    hole.BeyondFinalZero.QuadPart = sparseSize / 2;
+    QVERIFY(DeviceIoControl(handle, FSCTL_SET_ZERO_DATA, &hole, sizeof(hole), nullptr, 0, &returned, nullptr));
+    CloseHandle(handle);
+}
+
+// Whether a file still holds what writeSparseFile wrote.
+bool hasSparseContent(const QString &path, char contentChar)
+{
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly)) {
+        return false;
+    }
+    return file.readAll() == QByteArray(sparseSize / 2, '\0') + QByteArray(sparseSize / 2, contentChar);
+}
