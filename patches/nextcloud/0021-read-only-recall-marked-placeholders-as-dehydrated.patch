+// A file whose content is not on disk: a placeholder (cloud reparse tag) that Cloud Files
+// marks for recall on data access. Sparse alone is no such mark: an ordinary sparse file,
+// and one converted to an in-sync placeholder, keep FILE_ATTRIBUTE_SPARSE_FILE with all
+// their content on disk.
+bool isDehydratedPlaceholder(DWORD attributes, DWORD reparseTag)
+{
+    const auto hasCloudTag = (attributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0
+        && (reparseTag & ~IO_REPARSE_TAG_CLOUD_MASK) == (IO_REPARSE_TAG_CLOUD & ~IO_REPARSE_TAG_CLOUD_MASK);
+    return hasCloudTag && (attributes & FILE_ATTRIBUTE_DIRECTORY) == 0 && (attributes & FILE_ATTRIBUTE_RECALL_ON_DATA_ACCESS) != 0;
+}
+
 }
 
