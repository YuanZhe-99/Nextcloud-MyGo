+    /// Verifies that a modification below the chunk size is sent as chunks, not as one PUT over
+    /// the server file, while a new small file still uses one PUT.
+    void testSmallModificationIsChunked()
+    {
+        FakeFolder fakeFolder{FileInfo::A12_B12_C12_S12()};
+        fakeFolder.syncEngine().account()->setCapabilities({ { "dav", QVariantMap{ {"chunking", "1.0"} } } });
+        int directPuts = 0;
+        fakeFolder.setServerOverride([&](QNetworkAccessManager::Operation op, const QNetworkRequest &request, QIODevice *) -> QNetworkReply * {
+            if (op == QNetworkAccessManager::PutOperation && !request.url().path().contains(QStringLiteral("/uploads/"))) {
+                ++directPuts;
+            }
+            return nullptr;
+        });
+
+        fakeFolder.localModifier().insert("A/new", 100);
+        QVERIFY(fakeFolder.syncOnce());
+        QCOMPARE(directPuts, 1);
+        QCOMPARE(fakeFolder.uploadState().children.count(), 0);
+
+        fakeFolder.localModifier().appendByte("A/a1");
+        QVERIFY(fakeFolder.syncOnce());
+        QCOMPARE(directPuts, 1);
+        QCOMPARE(fakeFolder.uploadState().children.count(), 1); // the modification was chunked
+        QCOMPARE(fakeFolder.currentLocalState(), fakeFolder.currentRemoteState());
+    }
+
