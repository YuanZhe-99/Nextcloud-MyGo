+    // A dehydrated placeholder takes the server's new size when the server kept the file's etag.
+    void testServerSizeChangeUnderSameEtagUpdatesPlaceholder()
+    {
+        FakeFolder fakeFolder{FileInfo{}};
+        setupVfs(fakeFolder);
+        fakeFolder.remoteModifier().insert("a", 64);
+        QVERIFY(fakeFolder.syncOnce());
+        CFVERIFY_VIRTUAL(fakeFolder, "a");
+
+        auto &remote = fakeFolder.remoteModifier();
+        const auto etag = remote.find("a")->etag;
+        remote.appendByte("a");
+        remote.find("a")->etag = etag;
+        ItemCompletedSpy completeSpy(fakeFolder);
+        QVERIFY(fakeFolder.syncOnce());
+
+        // A server change to a local virtual file decays to a metadata update, as when the etag changes.
+        QCOMPARE(completeSpy.findItem("a")->_instruction, CSYNC_INSTRUCTION_UPDATE_METADATA);
+        CFVERIFY_VIRTUAL(fakeFolder, "a");
+        QCOMPARE(QFileInfo(fakeFolder.localPath() + "a").size(), qint64{65});
+        QCOMPARE(dbRecord(fakeFolder, "a")._fileSize, qint64{65});
+
+        // Nothing is left to do once the journal holds the server's size.
+        completeSpy.clear();
+        QVERIFY(fakeFolder.syncOnce());
+        QCOMPARE(completeSpy.findItem("a")->_instruction, CSYNC_INSTRUCTION_NONE);
+    }
