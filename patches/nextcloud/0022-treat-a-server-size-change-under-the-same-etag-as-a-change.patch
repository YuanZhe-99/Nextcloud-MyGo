+    void testServerSizeChangeUnderSameEtag_data()
+    {
+        QTest::addColumn<bool>("localEdit");
+        QTest::newRow("unchanged locally") << false;
+        QTest::newRow("edited locally") << true;
+    }
+
+    // A server can keep a file's etag when the file is rewritten twice within one second; the size still differs.
+    void testServerSizeChangeUnderSameEtag()
+    {
+        QFETCH(bool, localEdit);
+        FakeFolder fakeFolder{FileInfo::A12_B12_C12_S12()};
+        ItemCompletedSpy completeSpy(fakeFolder);
+
+        // The rewrite keeps the file's etag and modification time; its folders get new etags.
+        auto &remote = fakeFolder.remoteModifier();
+        const auto etag = remote.find("A/a1")->etag;
+        const auto size = remote.find("A/a1")->size;
+        remote.appendByte("A/a1");
+        remote.find("A/a1")->etag = etag;
+        if (localEdit) {
+            fakeFolder.localModifier().appendByte("A/a1");
+            fakeFolder.localModifier().appendByte("A/a1");
+            fakeFolder.localModifier().setContents("A/a1", 'L');
+        }
+        QVERIFY(fakeFolder.syncOnce());
+
+        // The server's content is kept and downloaded; a local edit becomes a conflict copy.
+        QCOMPARE(completeSpy.findItem("A/a1")->_instruction, localEdit ? CSYNC_INSTRUCTION_CONFLICT : CSYNC_INSTRUCTION_SYNC);
+        QCOMPARE(fakeFolder.currentRemoteState().find("A/a1")->size, size + 1);
+        QCOMPARE(fakeFolder.currentRemoteState().find("A/a1")->contentChar, 'W');
+        QCOMPARE(fakeFolder.currentLocalState().find("A/a1")->size, size + 1);
+        QCOMPARE(fakeFolder.currentLocalState().find("A/a1")->contentChar, 'W');
+        const auto conflicts = fakeFolder.syncJournal().conflictRecordPaths();
+        QCOMPARE(conflicts.size(), localEdit ? 1 : 0);
+        if (localEdit) {
+            const auto copy = fakeFolder.currentLocalState().find(QString::fromUtf8(conflicts.first()));
+            QVERIFY(copy);
+            QCOMPARE(copy->size, size + 2);
+            QCOMPARE(copy->contentChar, 'L');
+        }
+
+        // The journal now holds the server's size, so the next sync downloads nothing again.
+        SyncJournalFileRecord record;
+        QVERIFY(fakeFolder.syncJournal().getFileRecord(QByteArrayLiteral("A/a1"), &record));
+        QCOMPARE(record._fileSize, size + 1);
+        QCOMPARE(record._etag, etag);
+        completeSpy.clear();
+        QVERIFY(fakeFolder.syncOnce());
+        QCOMPARE(completeSpy.findItem("A/a1")->_instruction, CSYNC_INSTRUCTION_NONE);
+        QCOMPARE(fakeFolder.currentRemoteState().find("A/a1")->size, size + 1);
+    }
+
+    // The journal of an end-to-end encrypted file holds its plaintext size, the server the encrypted one.
+    void testEncryptedFileSizeIsNotComparedWithTheServer()
+    {
+        FakeFolder fakeFolder{FileInfo::A12_B12_C12_S12()};
+        SyncJournalFileRecord record;
+        QVERIFY(fakeFolder.syncJournal().getFileRecord(QByteArrayLiteral("A/a1"), &record));
+        record._e2eMangledName = QByteArrayLiteral("A/0123456789abcdef");
+        QVERIFY(fakeFolder.syncJournal().setFileRecord(record));
+
+        // The server's size is the plaintext size plus the 16-byte tag; the etag says nothing changed.
+        auto &remote = fakeFolder.remoteModifier();
+        const auto etag = remote.find("A/a1")->etag;
+        const auto size = remote.find("A/a1")->size;
+        for (auto i = 0; i < 16; ++i) {
+            remote.appendByte("A/a1");
+        }
+        remote.find("A/a1")->etag = etag;
+        remote.appendByte("A/a2");
+
+        ItemCompletedSpy completeSpy(fakeFolder);
+        QVERIFY(fakeFolder.syncOnce());
+        QCOMPARE(completeSpy.findItem("A/a2")->_instruction, CSYNC_INSTRUCTION_SYNC);
+        QCOMPARE(completeSpy.findItem("A/a1")->_instruction, CSYNC_INSTRUCTION_NONE);
+        QCOMPARE(fakeFolder.currentLocalState().find("A/a1")->size, size);
+    }
