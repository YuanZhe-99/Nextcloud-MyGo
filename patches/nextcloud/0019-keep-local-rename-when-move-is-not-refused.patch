+    void testMoveWithoutServerRefusalKeepsLocalRename_data()
+    {
+        QTest::addColumn<int>("httpCode");
+        QTest::addColumn<QNetworkReply::NetworkError>("networkError");
+        QTest::addColumn<bool>("committed");
+
+        QTest::newRow("connection refused") << 0 << QNetworkReply::ConnectionRefusedError << false;
+        QTest::newRow("timed out") << 0 << QNetworkReply::OperationCanceledError << false;
+        QTest::newRow("service unavailable") << 503 << QNetworkReply::ServiceUnavailableError << false;
+        QTest::newRow("gateway timeout") << 504 << QNetworkReply::UnknownServerError << false;
+        QTest::newRow("made, reply lost") << 0 << QNetworkReply::OperationCanceledError << true;
+    }
+
+    /// Verifies that a MOVE the server did not refuse keeps the local rename, and that the next
+    /// sync sends the same MOVE again, or adopts the one the server made, instead of an upload,
+    /// a download or a deletion.
+    void testMoveWithoutServerRefusalKeepsLocalRename()
+    {
+        QFETCH(int, httpCode);
+        QFETCH(QNetworkReply::NetworkError, networkError);
+        QFETCH(bool, committed);
+        FakeFolder fakeFolder{FileInfo::A12_B12_C12_S12()};
+        auto failMove = true;
+        auto moves = 0;
+        auto transfers = 0;
+        fakeFolder.setServerOverride([&](QNetworkAccessManager::Operation op, const QNetworkRequest &request, QIODevice *) -> QNetworkReply * {
+            if (op == QNetworkAccessManager::PutOperation || op == QNetworkAccessManager::GetOperation || op == QNetworkAccessManager::DeleteOperation) {
+                ++transfers;
+            } else if (request.attribute(QNetworkRequest::CustomVerbAttribute).toByteArray() == "MOVE") {
+                ++moves;
+                if (std::exchange(failMove, false)) {
+                    if (committed) {
+                        fakeFolder.remoteModifier().rename(QStringLiteral("A/a1"), QStringLiteral("A/a1m"));
+                    }
+                    const auto reply = new FakeErrorReply(op, request, this, httpCode);
+                    reply->setError(networkError, QStringLiteral("Fake transport failure"));
+                    return reply;
+                }
+            }
+            return nullptr;
+        });
+
+        fakeFolder.localModifier().rename("A/a1", "A/a1m");
+        QVERIFY(!fakeFolder.syncOnce());
+        QCOMPARE(moves, 1);
+        QVERIFY(fakeFolder.currentLocalState().find("A/a1m"));
+        QVERIFY(!fakeFolder.currentLocalState().find("A/a1"));
+        QCOMPARE(fakeFolder.currentRemoteState().find("A/a1") != nullptr, !committed);
+        SyncJournalFileRecord record;
+        QVERIFY(fakeFolder.syncJournal().getFileRecord(QStringLiteral("A/a1"), &record));
+        QVERIFY(record.isValid());
+
+        // A server error is retried once its blacklist entry expires; skip the wait.
+        QVERIFY(fakeFolder.syncJournal().wipeErrorBlacklist() >= 0);
+        QVERIFY(fakeFolder.syncOnce());
+        QCOMPARE(moves, committed ? 1 : 2);
+        QCOMPARE(transfers, 0);
+        QVERIFY(fakeFolder.currentRemoteState().find("A/a1m"));
+        QVERIFY(!fakeFolder.currentRemoteState().find("A/a1"));
+        QCOMPARE(fakeFolder.currentLocalState(), fakeFolder.currentRemoteState());
+    }
+
