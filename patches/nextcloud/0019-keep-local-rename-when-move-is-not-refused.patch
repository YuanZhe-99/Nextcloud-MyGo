     if (err != QNetworkReply::NoError) {
         SyncFileItem::Status status = classifyError(err, _item->_httpErrorCode,
             &propagator()->_anotherSyncNeeded);
+        // Without an answer from the server (a refused or lost connection, a timeout, an aborted
+        // sync) or with a gateway or availability error (502, 503, 504), the move was not refused;
+        // it may even have been made. Keep the local rename and the old journal record: the next
+        // discovery finds the same rename and sends the MOVE again, or finds the server's copy
+        // already at the new name and adopts it. An answer about this move (4xx, 500, 507) still
+        // restores the old name below.
+        if (_item->_httpErrorCode == 0 || (_item->_httpErrorCode >= 502 && _item->_httpErrorCode <= 504)) {
+            qCWarning(lcPropagateRemoteMove) << "Could not MOVE file" << _item->_originalFile << "to" << _item->_renameTarget
+                                             << "with error:" << _job->errorString() << "keeping the local rename for the next sync";
+            done(status, _job->errorString(), ErrorCategory::GenericError);
+            return;
+        }
         const auto filePath = propagator()->fullLocalPath(_item->_renameTarget);
         const auto filePathOriginal = propagator()->fullLocalPath(_item->_originalFile);
         const auto oldFile = QFileInfo{filePathOriginal};
