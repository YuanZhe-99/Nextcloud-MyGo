      },
      {
        "path": "patches/nextcloud/0002-generate-common-windows-icon-config.patch",
        "sha256": "b584aca1ac2b46410c5eb3416de20a016206a461cd57caeef2174eba430eb0af",
        "reason": "Generate the icon configuration included by Windows common code when BUILD_GUI is disabled."
      },
      {
        "path": "patches/nextcloud/0003-generate-shell-icon-config-without-plugin.patch",
        "sha256": "5e5292ae2ca9ae7f980db3921fe763bda6c23749236aae698cf2e997fc831f93",
        "reason": "Generate the shared Shell icon configuration needed by GUI tests when the CFAPI plugin is disabled."
      },
      {
        "path": "patches/nextcloud/0004-respect-test-build-targets.patch",
        "sha256": "20940722d349f921856daca739bcdb3ee8de2bcbc35167f628737d0337b9aa7e",
        "reason": "Respect optional CFAPI targets and multi-configuration UI header paths in upstream tests."
      },
      {
        "path": "patches/nextcloud/0005-own-local-discovery-workers.patch",
        "sha256": "a79bfc50f68f13a5cd30b51774b9c83ddeb2bed383028c53f1a7615e5bdbdddb",
        "reason": "Join discovery-phase local workers before their borrowed VFS is destroyed; ARM64 timeout regression passed 20/20 after reproducing the pre-fix crash."
      },
      {
        "path": "patches/nextcloud/0006-preserve-utc-date-boundaries.patch",
        "sha256": "f880e3a3a30c5db4ac560a2becbaeaf0aabaf5c0fc7c9ac000d50536e6e792fb",
        "reason": "Decode UTC date-boundary milliseconds as UTC; existing DateFieldBackend regression fails in negative UTC offsets before this fix."
      },
      {
        "path": "patches/nextcloud/0007-find-configured-cli-in-provisioning-test.patch",
        "sha256": "22d0b689efefdb5d1033798ead891d0237a24cd415428d4ef3e503839af1c282",
        "reason": "Find the CLI beside the test in multi-configuration builds and report process-start failure distinctly."
      },
      {
        "path": "patches/nextcloud/0008-isolate-provisioning-test-profiles.patch",
        "sha256": "4cc23450dd9eb91107e4eeb2b51b1be8456e17be2f69fd6e0b08b18fd7a49c89",
        "reason": "Give provisioning test subprocesses temporary profiles when no explicit profile was supplied, avoiding default client configuration."
      },
      {
        "path": "patches/nextcloud/0009-isolate-shell-ipc-test-pipe.patch",
        "sha256": "24f482620aad0b65b7d7b06940e1b7bcfc7189733db8aced2d8859070447ea3a",
        "reason": "Use a dedicated Shell IPC test pipe so a running client cannot intercept fixture requests."
      },
      {
        "path": "patches/nextcloud/0010-honor-pre-propagation-abort.patch",
        "sha256": "ad1adc7895add6c239f614e6f806fc04afb951aa40a210e73773597a4b64b9f2",
        "reason": "Stop before propagator creation when a direct pre-propagation safety observer aborts the cycle; includes an upstream no-write-and-retry regression."
      },
      {
        "path": "patches/nextcloud/0011-observe-journal-commit-failure.patch",
        "sha256": "7294b934a468228401210bdf761bef3d31b387113bad0a7c1d8e24b92146dcb2",
        "reason": "Expose sticky SQLite commit failure through journal close/reopen so adapter completion and switch quiescence cannot mistake a failed commit for durable state; regression rejects a real SQLite commit."
      },
      {
        "path": "patches/nextcloud/0012-create-headless-account-without-user-status.patch",
        "sha256": "73139ebdacd356a01a4bbed3f9560c99eaf1ebbddf3e9c181fd2061ddb26a6ed",
        "reason": "Let private headless accounts omit interactive user-status startup and its strong account ownership cycle; default upstream behavior is unchanged and account destruction is regression-tested."
      },
      {
        "path": "patches/nextcloud/0013-preserve-journal-on-integrity-failure.patch",
        "sha256": "5434284d1ea4813e05a39d27ef362694eaf2799ef968f19a88d381cfe4bfed57",
        "reason": "Disable automatic recreation specifically for sync journals after SQLite integrity-check failure; preserve original bytes and fail closed instead of implicitly forcing a resync."
      },
      {
        "path": "patches/nextcloud/0014-clear-completed-download-resume-state.patch",
        "sha256": "a81898fbfe4b7fd998aa4bfef35ad010009c43e3bea43f9fd82781d1af79a609",
        "reason": "Remove completed download resume state using the same file key used at transfer start; regressions preserve incomplete downloads and require cleanup after normal and resumed completion."
      },
      {
        "path": "patches/nextcloud/0015-keep-capability-updates-headless.patch",
        "sha256": "ada5295a01ee9a05cde9ad6729e2ae9dec6756415420721b9de37c9645306209",
        "reason": "Keep headless accounts free of interactive user-status, push and client-status services when sync capabilities are installed; the new narrow account regression failed !hasUserStatus before the guard."
      },
      {
        "path": "patches/nextcloud/0016-prove-chunk-recovery-across-origins.patch",
        "sha256": "3cb68bc2563fb3bac08318ca60eb2ceb77d0489255f78754cae2d1ad40b5c5ed",
        "reason": "Test-only: prove that an interrupted chunk session resumes after the account moves to another origin of the same server without resending chunks or contacting the previous origin, and that a committed final MOVE with a lost reply is adopted there without download, chunk or second MOVE. No library source changes."
      },
      {
        "path": "patches/nextcloud/0017-embed-cfapi-vfs-in-sync-service.patch",
        "sha256": "4dd16b323793e690f270b66c39c1adcefe69b8787914467bdd32209f49298244",
        "reason": "Build the Windows CFAPI plugin without its Explorer shell extension (BUILD_CFAPI_VFS); register sync roots under a caller-supplied account identity that does not contain the server host; name no shell-extension handler class or navigation-pane CLSID that was not registered; let the owner refuse new hydration/placeholder callbacks and observe running ones (Vfs::refuseNewRequests, Vfs::hasRequestsInFlight) before stopping. Default upstream behavior is unchanged."
      },
      {
        "path": "patches/nextcloud/0018-chunk-uploads-that-replace-a-server-file.patch",
        "sha256": "4d12844e0b3e62e71fd219798348a79c25871d6dc050bd0806a2bae2cd591779",
        "reason": "Send every nonempty upload that replaces a server file as a chunked (v2) upload when the server supports it, not as one PUT: Nextcloud 35 writes an update over the existing file in place, so a PUT cut mid-body left the server copy truncated (S05), and once the server re-read it the next cycle's conflict put the truncated copy at the user's path. The final MOVE assembles on the server. New files below the chunk size still use one PUT; testSmallModificationIsChunked covers both; connectionDroppedBeforeEtagRecieved keeps its single-PUT case on a server without chunking."
      }
    ]
  },
